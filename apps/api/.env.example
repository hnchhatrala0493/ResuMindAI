NODE_ENV=development
APP_NAME=ResuMind AI
PORT=5000
WEB_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/resumind
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_NAME=resumind_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
PASSWORD_BCRYPT_ROUNDS=12
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=ResuMind AI
EMAIL_FROM_ADDRESS=no-reply@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
# Phase 3 AI (mock is safe for local development and CI)
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_FREE_CREDITS=10
AI_MONTHLY_PRO_CREDITS=500
AI_FEATURES_ENABLED=true
ATS_AI_ANALYSIS_ENABLED=true
# Phase 4 document processing
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_PARSE_TIMEOUT_MS=15000
EXPORT_RENDER_TIMEOUT_MS=30000
EXPORT_MAX_CONCURRENT=2
EXPORT_IDEMPOTENCY_TTL_HOURS=24
MALWARE_SCAN_ENABLED=false
MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=10000
MALWARE_SCAN_FAIL_MODE=closed
PUBLIC_VIEW_DEDUPE_MINUTES=30
SHARE_UNLOCK_TTL_MINUTES=15
